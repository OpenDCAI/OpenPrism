{
  "name": "openprism",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/frontend run dev",
    "e2e": "npm --workspace apps/frontend run e2e --",
    "typecheck": "npm --workspace apps/frontend run typecheck",
    "build": "npm --workspace apps/frontend run build",
    "preview": "npm --workspace apps/frontend run preview"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
