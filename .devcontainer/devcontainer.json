{
  "name": "OpenPrism",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "sudo chown -R node:node /home/node/.claude && npm install",
  // "initializeCommand": "test -f .env || cp .env.sample .env",
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],
  "forwardPorts": [5173, 8080, 8000, 5432, 6379, 3900, 8025],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite dev)" },
    "8080": { "label": "App (nginx)" },
    "8025": { "label": "Mailpit (dev mail)" },
    "8000": { "label": "API (Django)" },
    "5432": { "label": "Postgres" },
    "6379": { "label": "Redis" },
    "3900": { "label": "Garage S3" }
  },
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "James-Yu.latex-workshop"
      ]
    }
  }
}
